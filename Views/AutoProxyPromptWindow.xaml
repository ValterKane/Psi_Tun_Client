<Window x:Class="PsiTun.Views.AutoProxyPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" SizeToContent="WidthAndHeight"
        Background="Transparent" ResizeMode="NoResize" FontFamily="Segoe UI" FontSize="13">
    <Border Background="#EE1E1E2E" CornerRadius="8" Padding="14" Margin="8"
            BorderBrush="#40FFFFFF" BorderThickness="1">
        <StackPanel Width="360">
            <TextBlock Text="{Binding Message}" Foreground="#E0E0E0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Проксировать" Command="{Binding ProxyCommand}"
                        Padding="12,4" Margin="0,0,8,0"/>
                <Button Content="Нет" Command="{Binding DenyCommand}" Padding="12,4"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
